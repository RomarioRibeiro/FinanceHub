@model IEnumerable<FinanceHub.Models.Meta>

@{
    ViewData["Title"] = "Lista de Metas";
}

<h2>@ViewData["Title"]</h2>
@if (TempData["Erro"] is string erro)
{
    <div class="alert alert-danger">@erro</div>
}
<p><a class="btn btn-primary" asp-action="Create">Novo</a></p>
<table class="table">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Valor Alvo</th>
            <th>Valor Atual</th>
            <th>Ativa</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Nome</td>
            <td>@item.ValorAlvo</td>
            <td>@item.ValorAtual</td>
            <td>@item.Ativa</td>
            <td>
                <a class="btn btn-primary" asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                <a class="btn btn-secondary" asp-action="Details" asp-route-id="@item.Id">Detalhes</a>
                <a class="btn btn-danger" asp-action="Delete" asp-route-id="@item.Id">Excluir</a>
            </td>
        </tr>
    }
    </tbody>
</table>
