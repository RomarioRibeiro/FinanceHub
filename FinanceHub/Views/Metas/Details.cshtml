@model FinanceHub.Models.Meta

@{
    ViewData["Title"] = "Detalhes Meta";
}

<h1>@ViewData["Title"]</h1>

<dl class="row">
    <dt class="col-sm-2">Nome</dt>
    <dd class="col-sm-10">@Model.Nome</dd>
    <dt class="col-sm-2">Valor Alvo</dt>
    <dd class="col-sm-10">@Model.ValorAlvo</dd>
    <dt class="col-sm-2">Valor Atual</dt>
    <dd class="col-sm-10">@Model.ValorAtual</dd>
</dl>

<a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a>
<a class="btn btn-secondary" asp-action="Index">Voltar</a>
