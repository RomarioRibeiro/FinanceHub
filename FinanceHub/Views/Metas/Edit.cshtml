@model FinanceHub.Models.Meta

@{
    ViewData["Title"] = "Editar meta";
}
<link rel="stylesheet" href="~/css/metas.css" asp-append-version="true" />

<h1>@ViewData["Title"]</h1>

<form asp-action="Edit" class="meta-form">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <partial name="_FormFields" model="Model" />

    <div class="mb-3">
        <label asp-for="ValorAtual" class="form-label">Valor acumulado</label>
        <input asp-for="ValorAtual" class="form-control" inputmode="decimal" />
        <span asp-validation-for="ValorAtual" class="text-danger"></span>
    </div>
    <div class="mb-3 form-check meta-active-check">
        <input asp-for="Ativa" class="form-check-input" />
        <label asp-for="Ativa" class="form-check-label">Meta ativa</label>
    </div>

    <div class="meta-form-actions">
        <button type="submit" class="btn btn-primary">
            <i class="fa-solid fa-check"></i> Salvar
        </button>
        <a class="btn btn-secondary" asp-action="Index">Voltar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_MetaFormScripts" />
}
