@using FinanceHub.Models.Enums
@model FinanceHub.Models.LancamentoRecorrente

@{
    ViewData["Title"] = "Cadastro Lancamento Recorrente";
}

<h1>@ViewData["Title"]</h1>

<form asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="UsuarioId" class="form-label"></label>
        <input asp-for="UsuarioId" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="CategoriaId" class="form-label"></label>
        <input asp-for="CategoriaId" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Descricao" class="form-label"></label>
        <input asp-for="Descricao" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Valor" class="form-label"></label>
        <input asp-for="Valor" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Tipo" class="form-label"></label>
        <select asp-for="Tipo" asp-items="Html.GetEnumSelectList<TipoCategoria>()" class="form-control"></select>
    </div>
    <div class="mb-3">
        <label asp-for="DataInicial" class="form-label"></label>
        <input asp-for="DataInicial" class="form-control" type="datetime-local" />
    </div>
    <div class="mb-3">
        <label asp-for="Frequencia" class="form-label"></label>
        <input asp-for="Frequencia" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="DiaReferencia" class="form-label"></label>
        <input asp-for="DiaReferencia" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Salvar</button>
    <a class="btn btn-secondary" asp-action="Index">Voltar</a>
</form>
