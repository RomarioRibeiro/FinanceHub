@using FinanceHub.Models.Enums
@model FinanceHub.Models.LancamentoRecorrente

@{
    ViewData["Title"] = "Editar Lancamento Recorrente";
}

<h1>@ViewData["Title"]</h1>

<form asp-action="Edit">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="CategoriaId" class="form-label">Categoria</label>
        <select asp-for="CategoriaId" asp-items="ViewBag.Categorias" class="form-select">
            <option value="">Selecione uma categoria</option>
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="Descricao" class="form-label"></label>
        <input asp-for="Descricao" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Valor" class="form-label"></label>
        <input asp-for="Valor" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="DataInicial" class="form-label"></label>
        <input asp-for="DataInicial" class="form-control" type="datetime-local" />
    </div>
    <div class="mb-3">
        <label asp-for="Frequencia" class="form-label"></label>
        <input asp-for="Frequencia" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="DiaReferencia" class="form-label"></label>
        <input asp-for="DiaReferencia" class="form-control" />
    </div>
    <div class="mb-3 form-check">
        <input asp-for="Ativo" class="form-check-input" />
        <label asp-for="Ativo" class="form-check-label"></label>
    </div>
    <button type="submit" class="btn btn-primary">Salvar</button>
    <a class="btn btn-secondary" asp-action="Index">Voltar</a>
</form>
