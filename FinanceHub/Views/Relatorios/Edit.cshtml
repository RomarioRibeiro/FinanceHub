@using FinanceHub.Models.Enums
@model FinanceHub.Models.Relatorio

@{
    ViewData["Title"] = "Editar Relatorio";
}

<h1>@ViewData["Title"]</h1>

<form asp-action="Edit">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="UsuarioId" class="form-label"></label>
        <input asp-for="UsuarioId" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Tipo" class="form-label"></label>
        <select asp-for="Tipo" asp-items="Html.GetEnumSelectList<TipoRelatorio>()" class="form-control"></select>
    </div>
    <div class="mb-3">
        <label asp-for="DataInicio" class="form-label"></label>
        <input asp-for="DataInicio" class="form-control" type="datetime-local" />
    </div>
    <div class="mb-3">
        <label asp-for="DataFim" class="form-label"></label>
        <input asp-for="DataFim" class="form-control" type="datetime-local" />
    </div>
    <div class="mb-3">
        <label asp-for="GeradoEm" class="form-label"></label>
        <input asp-for="GeradoEm" class="form-control" type="datetime-local" />
    </div>
    <button type="submit" class="btn btn-primary">Salvar</button>
    <a class="btn btn-secondary" asp-action="Index">Voltar</a>
</form>
