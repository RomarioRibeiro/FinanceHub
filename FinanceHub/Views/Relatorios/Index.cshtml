@model IEnumerable<FinanceHub.Models.Relatorio>

@{
    ViewData["Title"] = "Lista de Relatorios";
}

<h2>@ViewData["Title"]</h2>
<p><a class="btn btn-primary" asp-action="Create">Novo</a></p>
<table class="table">
    <thead>
        <tr>
            <th>Tipo</th>
            <th>Data Inicio</th>
            <th>Data Fim</th>
            <th>Gerado Em</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Tipo</td>
            <td>@item.DataInicio</td>
            <td>@item.DataFim</td>
            <td>@item.GeradoEm</td>
            <td>
                <a class="btn btn-primary" asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                <a class="btn btn-secondary" asp-action="Details" asp-route-id="@item.Id">Detalhes</a>
                <a class="btn btn-danger" asp-action="Delete" asp-route-id="@item.Id">Excluir</a>
            </td>
        </tr>
    }
    </tbody>
</table>
