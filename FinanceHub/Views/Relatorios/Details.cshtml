@model FinanceHub.Models.Relatorio

@{
    ViewData["Title"] = "Detalhes Relatorio";
}

<h1>@ViewData["Title"]</h1>

<dl class="row">
    <dt class="col-sm-2">Tipo</dt>
    <dd class="col-sm-10">@Model.Tipo</dd>
    <dt class="col-sm-2">Data Inicio</dt>
    <dd class="col-sm-10">@Model.DataInicio</dd>
    <dt class="col-sm-2">Data Fim</dt>
    <dd class="col-sm-10">@Model.DataFim</dd>
</dl>

<a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a>
<a class="btn btn-secondary" asp-action="Index">Voltar</a>
