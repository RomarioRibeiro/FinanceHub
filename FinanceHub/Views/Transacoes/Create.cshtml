@using FinanceHub.Models.Enums
@model FinanceHub.Models.Transacao

@{
    ViewData["Title"] = "Cadastro Transacao";
}

<h1>@ViewData["Title"]</h1>

<form asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="UsuarioId" class="form-label">Usuario</label>
        <select asp-for="UsuarioId" asp-items="ViewBag.Usuarios" class="form-select">
            <option value="">Selecione um usuario</option>
        </select>
        <span asp-validation-for="UsuarioId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="CategoriaId" class="form-label">Categoria</label>
        <select asp-for="CategoriaId" asp-items="ViewBag.Categorias" class="form-select">
            <option value="">Selecione uma categoria</option>
        </select>
        <span asp-validation-for="CategoriaId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ContaId" class="form-label">Conta</label>
        <select asp-for="ContaId" asp-items="ViewBag.Contas" class="form-select">
            <option value="">Selecione uma conta</option>
        </select>
        <span asp-validation-for="ContaId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="TipoCategoria" class="form-label"></label>
        <select asp-for="TipoCategoria" asp-items="Html.GetEnumSelectList<TipoCategoria>()" class="form-control"></select>
    </div>
    <div class="mb-3">
        <label asp-for="Descricao" class="form-label"></label>
        <input asp-for="Descricao" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Valor" class="form-label"></label>
        <input asp-for="Valor" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Data" class="form-label"></label>
        <input asp-for="Data" class="form-control" type="datetime-local" />
    </div>
    <div class="mb-3">
        <label asp-for="Observacao" class="form-label"></label>
        <textarea asp-for="Observacao" class="form-control"></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Salvar</button>
    <a class="btn btn-secondary" asp-action="Index">Voltar</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
