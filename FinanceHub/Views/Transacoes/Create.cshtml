@using FinanceHub.Models.Enums
@model FinanceHub.Models.Transacao

@{
    ViewData["Title"] = "Cadastro Transacao";
}

<h1>@ViewData["Title"]</h1>

<form asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="UsuarioId" class="form-label"></label>
        <input asp-for="UsuarioId" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="CategoriaId" class="form-label"></label>
        <input asp-for="CategoriaId" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="ContaId" class="form-label"></label>
        <input asp-for="ContaId" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="TipoCategoria" class="form-label"></label>
        <select asp-for="TipoCategoria" asp-items="Html.GetEnumSelectList<TipoCategoria>()" class="form-control"></select>
    </div>
    <div class="mb-3">
        <label asp-for="Descricao" class="form-label"></label>
        <input asp-for="Descricao" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Valor" class="form-label"></label>
        <input asp-for="Valor" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Data" class="form-label"></label>
        <input asp-for="Data" class="form-control" type="datetime-local" />
    </div>
    <div class="mb-3">
        <label asp-for="Observacao" class="form-label"></label>
        <textarea asp-for="Observacao" class="form-control"></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Salvar</button>
    <a class="btn btn-secondary" asp-action="Index">Voltar</a>
</form>
