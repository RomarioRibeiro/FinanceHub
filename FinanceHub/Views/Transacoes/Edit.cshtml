@using FinanceHub.Models.Enums
@model FinanceHub.Models.Transacao

@{
    ViewData["Title"] = "Editar Transacao";
}

<h1>@ViewData["Title"]</h1>

<form asp-action="Edit">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    @if (!(ViewBag.PossuiCategorias as bool? ?? false))
    {
        <div class="alert alert-warning">
            Nenhuma categoria cadastrada.
            <a asp-controller="Categorias" asp-action="Create">Cadastrar categoria</a>
        </div>
    }

    @if (!(ViewBag.PossuiContas as bool? ?? false))
    {
        <div class="alert alert-warning">
            Nenhuma conta ativa disponivel.
            <a asp-controller="Contas" asp-action="Create">Cadastrar conta</a>
        </div>
    }

    <div class="mb-3">
        <label asp-for="CategoriaId" class="form-label">Categoria</label>
        <select asp-for="CategoriaId"
                asp-items="ViewBag.Categorias"
                class="form-select"
                disabled="@(!(ViewBag.PossuiCategorias as bool? ?? false) ? "disabled" : null)">
            <option value="">Selecione uma categoria</option>
        </select>
        <span asp-validation-for="CategoriaId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ContaId" class="form-label">Conta</label>
        <select asp-for="ContaId"
                asp-items="ViewBag.Contas"
                class="form-select"
                disabled="@(!(ViewBag.PossuiContas as bool? ?? false) ? "disabled" : null)">
            <option value="">Selecione uma conta</option>
        </select>
        <span asp-validation-for="ContaId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Descricao" class="form-label"></label>
        <input asp-for="Descricao" class="form-control" />
        <span asp-validation-for="Descricao" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Valor" class="form-label"></label>
        <input asp-for="Valor" class="form-control" inputmode="decimal" />
        <span asp-validation-for="Valor" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Data" class="form-label"></label>
        <input asp-for="Data" class="form-control" type="datetime-local" />
        <span asp-validation-for="Data" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Observacao" class="form-label"></label>
        <textarea asp-for="Observacao" class="form-control"></textarea>
        <span asp-validation-for="Observacao" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary" disabled="@(!(ViewBag.PodeSalvar as bool? ?? false) ? "disabled" : null)">Salvar</button>
    <a class="btn btn-secondary" asp-action="Index">Voltar</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
