@model IEnumerable<FinanceHub.Models.Transacao>

@{
    ViewData["Title"] = "Lista de Transacoes";
}

<h2>@ViewData["Title"]</h2>
@if (TempData["Erro"] is string erro)
{
    <div class="alert alert-danger">@erro</div>
}
<p><a class="btn btn-primary" asp-action="Create">Novo</a></p>
<table class="table">
    <thead>
        <tr>
            <th>Descricao</th>
            <th>Valor</th>
            <th>Data</th>
            <th>Tipo</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Descricao</td>
            <td>@item.Valor</td>
            <td>@item.Data</td>
            <td>@item.TipoCategoria</td>
            <td>
                <a class="btn btn-primary" asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                <a class="btn btn-secondary" asp-action="Details" asp-route-id="@item.Id">Detalhes</a>
                <a class="btn btn-danger" asp-action="Delete" asp-route-id="@item.Id">Excluir</a>
            </td>
        </tr>
    }
    </tbody>
</table>
