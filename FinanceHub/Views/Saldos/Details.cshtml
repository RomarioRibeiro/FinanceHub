@model FinanceHub.Models.Saldo

@{
    ViewData["Title"] = "Detalhes Saldo";
}

<h1>@ViewData["Title"]</h1>

<dl class="row">
    <dt class="col-sm-2">ContaId</dt>
    <dd class="col-sm-10">@Model.ContaId</dd>
    <dt class="col-sm-2">Data</dt>
    <dd class="col-sm-10">@Model.Data</dd>
    <dt class="col-sm-2">Valor</dt>
    <dd class="col-sm-10">@Model.Valor</dd>
</dl>

<a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a>
<a class="btn btn-secondary" asp-action="Index">Voltar</a>
