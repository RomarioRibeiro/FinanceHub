@model FinanceHub.Models.ViewModels.SaldoContaViewModel

@{
    ViewData["Title"] = "Detalhes Saldo";
}

<h1>@ViewData["Title"]</h1>

<dl class="row">
    <dt class="col-sm-2">Conta</dt>
    <dd class="col-sm-10">@Model.ContaNome</dd>
    <dt class="col-sm-2">Tipo</dt>
    <dd class="col-sm-10">@Model.TipoConta</dd>
    <dt class="col-sm-2">Saldo Inicial</dt>
    <dd class="col-sm-10">@Model.SaldoInicial.ToString("C")</dd>
    <dt class="col-sm-2">Saldo Atual</dt>
    <dd class="col-sm-10">@Model.SaldoAtual.ToString("C")</dd>
    <dt class="col-sm-2">Status</dt>
    <dd class="col-sm-10">@(Model.Ativa ? "Ativa" : "Inativa")</dd>
</dl>

<a class="btn btn-secondary" asp-action="Index">Voltar</a>
