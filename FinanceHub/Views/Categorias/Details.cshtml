@model FinanceHub.Models.Categoria

@{
    ViewData["Title"] = "Detalhe da Categoria";
}

<h1>@ViewData["Title"]</h1>

    <hr />
<div class="card">
    <div class="card-body">

  
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Nome)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Nome)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Descricao)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Descricao)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.TipoCategoria)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TipoCategoria)
        </dd>
    </dl>
    </div>
</div>
<div style="margin-top: 10px">
    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model?.Id">Editar</a> 
    <a class="btn btn-secondary" asp-action="Index">Voltar</a>
</div>
