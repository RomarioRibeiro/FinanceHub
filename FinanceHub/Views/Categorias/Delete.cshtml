@model FinanceHub.Models.Categoria

@{
    ViewData["Title"] = "Delete";
    ViewData["Codigo"] = Model.Id;
}


<h3>Deseja excluir a categoria do codigo @ViewData["Codigo"]?</h3>
<hr />

<div class="card">
    <div class="card-body">

        <div>
            <dl class="row">
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Nome)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Nome)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Descricao)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Descricao)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.TipoCategoria)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.TipoCategoria)
                </dd>
            </dl>

            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <input type="submit" value="Excluir" class="btn btn-danger" /> 
                <a class="btn btn-secondary" asp-action="Index">Voltar</a>
            </form>
        </div>

    </div>
</div>
