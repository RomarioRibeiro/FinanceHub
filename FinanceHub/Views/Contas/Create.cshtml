@using FinanceHub.Models.Enums
@model FinanceHub.Models.Conta

@{
    ViewData["Title"] = "Cadastro Conta";
}

<h1>@ViewData["Title"]</h1>

<form asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="UsuarioId" class="form-label">Usuario</label>
        <select asp-for="UsuarioId" asp-items="ViewBag.Usuarios" class="form-select">
            <option value="">Selecione um usuario</option>
        </select>
        <span asp-validation-for="UsuarioId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Nome" class="form-label"></label>
        <input asp-for="Nome" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Tipo" class="form-label"></label>
        <select asp-for="Tipo" asp-items="Html.GetEnumSelectList<TipoConta>()" class="form-control"></select>
    </div>
    <div class="mb-3">
        <label asp-for="SaldoInicial" class="form-label"></label>
        <input asp-for="SaldoInicial" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="SaldoAtual" class="form-label"></label>
        <input asp-for="SaldoAtual" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Salvar</button>
    <a class="btn btn-secondary" asp-action="Index">Voltar</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
