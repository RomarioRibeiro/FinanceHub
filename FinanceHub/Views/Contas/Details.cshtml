@model FinanceHub.Models.Conta

@{
    ViewData["Title"] = "Detalhes Conta";
}

<h1>@ViewData["Title"]</h1>

<dl class="row">
    <dt class="col-sm-2">Nome</dt>
    <dd class="col-sm-10">@Model.Nome</dd>
    <dt class="col-sm-2">Tipo</dt>
    <dd class="col-sm-10">@Model.Tipo</dd>
    <dt class="col-sm-2">Saldo Atual</dt>
    <dd class="col-sm-10">@Model.SaldoAtual</dd>
</dl>

<a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a>
<a class="btn btn-secondary" asp-action="Index">Voltar</a>
