@model ErrorViewModel
@{
    ViewData["Title"] = "Nao foi possivel concluir";
}

<section class="error-state">
    <span class="error-state-icon">
        <i class="fa-solid fa-triangle-exclamation"></i>
    </span>
    <div>
        <span class="error-state-kicker">Erro inesperado</span>
        <h1>Nao foi possivel concluir esta operacao.</h1>
        <p>Tente novamente. Se o problema continuar, utilize o codigo abaixo para identificar a requisicao.</p>

        @if (Model.ShowRequestId)
        {
            <p class="error-request">
                <strong>Codigo da requisicao</strong>
                <code>@Model.RequestId</code>
            </p>
        }

        <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Voltar ao inicio</a>
    </div>
</section>
